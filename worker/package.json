{
  "name": "tayo-alert-worker",
  "version": "1.0.0",
  "private": true,
  "description": "TAYO (Structure-Liquidity-Key levels) alert scanner \u2014 Cloudflare Worker",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "deploy:worker": "wrangler deploy",
    "dev": "wrangler dev",
    "db:init": "wrangler d1 execute slk-alert-db --file=migrations/0001_init.sql",
    "db:init:local": "wrangler d1 execute slk-alert-db --local --file=migrations/0001_init.sql",
    "audit:coverage": "node --experimental-strip-types scripts/audit_coverage.ts",
    "audit:suppression": "node --experimental-strip-types scripts/audit_suppression.ts",
    "audit:shadow": "node --experimental-strip-types scripts/audit_shadow.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "wrangler": ">=3.80.0"
  }
}
