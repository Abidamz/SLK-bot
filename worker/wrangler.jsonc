{
  "name": "slk-alert-worker",
  "main": "src/index.ts",
  // Compatibility date must not be newer than the wrangler build doing the
  // deploy ("compatibility date is in the future" error otherwise). The code
  // uses no compat-flag-gated behavior, so a stable older date is fine.
  "compatibility_date": "2024-10-01",
  "triggers": {
    // every minute — the engine only scans timeframes whose candle just closed
    "crons": ["*/1 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "slk-alert-db",
      "database_id": "48ad2f08-d27d-4491-ad6c-13ad741b9ae3",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // non-secret config — see src/config.ts for what each of these does
    // Watchlist — canonical names. PROVIDER_MAP explicitly routes covered
    // institutional pairs to OANDA; index CFDs also support the keyless
    // Dukascopy public feed when OANDA is unavailable; canonical provider
    // instrument mappings are defined in worker/src/provider.ts.
    //
    // CUT FROM 23 TO 4 on 2026-10-11, on the 180d OANDA replay recorded in
    // docs/BACKTEST_FINDINGS_2026-10-11.md. The criterion is one thing only:
    // spread-adjusted positive in BOTH the full 180d window and the older 90d
    // sub-window. Six of the thirteen institutional pairs met it.
    //
    //   listed   JAPAN225 +12.7R / +9.2R     NAS100 +12.8R / +14.9R
    //            EURUSD   +10.7R / +10.7R    XAUUSD  +0.2R /  +3.7R
    //   held     EURJPY    +2.2R /  +1.0R    US30    +0.4R /  +0.2R
    //
    // XAUUSD was left out of the first cut and restored the same day. It meets
    // the criterion; excluding it was a magnitude judgement that was never
    // stated as one, which is the error worth recording. EURJPY and US30 meet
    // it too and are held rather than dropped - restore candidates in that
    // order, the owner's call rather than a silent exclusion.
    //
    // USDJPY (+0.7R over 180d, -5.2R over the older 90d) flipped sign between
    // windows and does not qualify. GBPJPY, GBPUSD, GER40, NZDUSD, AUDJPY and
    // USDCAD were negative in both.
    //
    // This is IN-SAMPLE SELECTION: the pairs were picked from the same window
    // being measured, and the older 90d run is a sub-window rather than
    // out-of-sample. Expect forward results to come in below these figures.
    //
    // All ten Deriv synthetics were removed here. They have never produced a
    // stored alert, and the backtest cannot produce a result for them at all:
    // it requires OANDA, which does not carry them. Cut as UNPROVEN, not as
    // measured losers. SYNTH_ENTRY_TFS and the Deriv routing are left in place
    // so they can return without further code changes.
    "PAIRS": "JAPAN225,NAS100,EURUSD,XAUUSD",
    "ENTRY_TFS": "15m,30m,1h",
    // Deriv synthetics confirm on the selected primary timeframes; institutional
    // pairs continue to use the full ENTRY_TFS set.
    "SYNTH_ENTRY_TFS": "30m,1h",
    // 100 preserves the legacy retest threshold (return to the origin zone,
    // ATR-tolerant); 1–99 require that percent of penetration into a
    // direction-matched FVG that overlaps the origin zone.
    // Reverted 100 -> 60 -> 100: at 60 the retest check depends on
    // fvgRetestThreshold(), which returns null (making a retest impossible)
    // whenever no such FVG exists. Retest candidates fell from ~220/day to
    // zero within hours of switching to 60 on 2026-10-06 14:29Z. See
    // CONTINUATION_HANDOFF.md. Do not re-enable 1-99 without reading
    // diagnostics.replay.retestNoFvg / retestWithFvg first.
    "RETEST_DEPTH_PCT": "100",
    // HTF Bias Hard Gate: suppress VIP counter-trend alerts on synthetics when
    // the shadow classifier flags HTF_CONFLICT (behavior-neutral on entries)
    "FILTER_HTF_CONFLICT_DERIV_ONLY": "true",
    "MODE": "paper",
    "PAPER_NOTIFY": "true",
    "ENGINE_DIGEST": "true",
    // Free pre-entry posts are paused; if re-enabled, only one SHIFT card per setup is sent.
    "WATCH_NOTIFY": "true",
    // Higher-timeframe context cards are a separate opt-in and remain off.
    "BIAS_NOTIFY": "true",
    // Keep VIP channels (Institutional & Synthetics) clean: only confirmed entry signals + outcomes delivered
    "VIP_WATCH_NOTIFY": "false",
    // Automated visual chart snapshots via Telegram sendPhoto (Recommendation 3)
    "CHART_SNAPSHOTS": "true",
    "MIN_RISK_ATR": "0.8",
    // Minimum breaking-candle BODY in ATR for a level to count as disrespected;
    // unset means any close beyond the zone flips it, which is what runs today.
    // The spec requires an impulsive BODY DISPLACEMENT candle. Body, not range:
    // a wick through the zone with a small body is a sweep, the opposite event.
    // Measure with BACKTEST_FLIP_IMPULSE_ATR (try 1.0) before setting it here.
    "MIN_STOP_PIPS": "10",
    // Stop-distance CEILING in pips, FX only; unset means no ceiling. The
    // teaching is "my highest stop loss I can go for every trade is 10 pips".
    // Left unset until measured: with MIN_STOP_PIPS also at 10 this makes every
    // FX stop exactly 10 pips and rejects any setup needing more, which trades
    // alert volume for R per trade. Costs make it FX-only - a literal 10-unit
    // stop is 0.80R of spread on JAPAN225 against 0.02R on EURUSD. Measure with
    // BACKTEST_MAX_STOP_PIPS=10 before setting it here.
    // Market entry, not a pending limit at the retest close. Measured over the
    // 360-day replay on the same alerts: pending limit 31.06R, market at the
    // next open 36.33R (+17%), and 3 alerts never filled the limit at all, so
    // those trades never happened. The limit order was the worst of the three
    // entry models on both the 180d and 360d windows. Set to "limit" to restore
    // the previous instruction without a code change.
    "EXECUTION_MODE": "market",
    // Credit a flipped level in origin selection only when the flip agrees
    // with the trade: an RBS (broke up, now support below) for a long, an SBR
    // (broke down, now resistance above) for a short. Off because the
    // undirected version - which scores ANY flip at 1.0, so a bearish break
    // lifts a long's origin just as much - is what has been running. Measure it
    // with BACKTEST_FLIP_DIRECTION_AWARE=true before turning it on here.
    "FLIP_DIRECTION_AWARE": "false",
    "MIN_TP_R": "2.5",
    "SL_BUFFER_ATR": "0.25",
    // Two markets per cron tick. Measured 2026-10-07 after the scheduler/store
    // work: a full tick runs 5-15 s (11-15 s for three-timeframe pairs,
    // 6.6-8.3 s for single-timeframe ones) against the 60 s cron budget, so a
    // second pair lands ~15-30 s and roughly halves the per-pair revisit time
    // (~23 min -> ~12 min). Scheduling only - no gate, threshold, pair list,
    // timeframe, or delivery change.
    "PAIR_BATCH_SIZE": "2",
    "DERIV_PROXY_URL": "https://slk-bot.vercel.app",
    "FILTER_HTF_CONFLICT": "true",
    // Cooldown keying. "pair_direction_tf" scopes the 240m cooldown to the
    // setup's own entry timeframe, so a delivered 30m signal no longer silences
    // a later 1h signal on the same pair. "pair_direction" restores the old
    // behaviour, where one signal blocked every timeframe on that pair and
    // direction for the full window. Config flag: switching takes a deploy.
    // (FILTER_HTF_CONFLICT_DERIV_ONLY was duplicated here; one copy removed.)
    "COOLDOWN_SCOPE": "pair_direction_tf",
    // Suppress a second alert on the same origin level that another timeframe
    // has already published. Two timeframes confirming one level are a single
    // trade; publishing both quietly doubles a subscriber's risk on one thesis.
    // The first timeframe to confirm wins: better entry, faster notification.
    //
    // Re-enabled 2026-10-09. It was switched off the previous day so both
    // timeframes could run. The JAPAN225 setup that decided it is now closed:
    // both the 15m and the 1h confirmed the same origin level
    // (68918.000000:2026-10-02T04:00) and both hit SL, so publishing both
    // cost -2R where either one alone would have cost -1R. One trade is not
    // proof, but it is the first real evidence and it points this way.
    // Set "false" to disable.
    "DEDUP_SAME_LEVEL": "true",
    "PROVIDER_MAP": "{\"EURUSD\":\"oanda\",\"GBPUSD\":\"oanda\",\"USDJPY\":\"oanda\",\"AUDJPY\":\"oanda\",\"GBPJPY\":\"oanda\",\"USDCAD\":\"oanda\",\"NZDUSD\":\"oanda\",\"EURJPY\":\"oanda\",\"XAUUSD\":\"oanda\",\"US30\":\"oanda\",\"GER40\":\"oanda\",\"JAPAN225\":\"oanda\",\"NAS100\":\"oanda\"}"
  }
  // secrets (set via `npx wrangler secret put ...`):
  //   TWELVEDATA_API_KEY  TELEGRAM_BOT_TOKEN  TELEGRAM_CHAT_ID
  //   DISCORD_WEBHOOK_URL ADMIN_KEY
}
