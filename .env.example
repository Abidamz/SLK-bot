# Secrets for SLK-bot. Copy to .env and fill in what you use.
#   cp .env.example .env

# Telegram — create a bot via @BotFather, get the token; then message your
# bot and read your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord — Server channel → Edit Channel → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=

# Twelve Data (recommended market data) — free key at https://twelvedata.com/
# If empty, the bot uses yfinance automatically (no key needed).
TWELVEDATA_API_KEY=

# Optional: alternative config file location
# SLK_CONFIG=config.yaml
