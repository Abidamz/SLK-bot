# Secrets for TAYO-bot. Copy to .env and fill in what you use.
#   cp .env.example .env

# Telegram — create a bot via @BotFather, get the token; then message your
# bot and read your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord — Server channel → Edit Channel → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=

# OANDA — required by worker/scripts/backtest.ts for candle history. Create a
# practice account at oanda.com, then Account -> Manage API Access -> Generate.
# The script reads this file automatically, so a Codespace restart does not
# need a fresh `export`. A real export still overrides it. This file is
# gitignored; never commit the filled-in copy.
OANDA_API_TOKEN=

# Optional Twelve Data key. Worker provider routing and failover behavior
# are defined in worker/src/provider.ts.
TWELVEDATA_API_KEY=

# Optional: alternative config file location
# TAYO_CONFIG=config.yaml

# Worker pre-entry messages are separate opt-ins; both are off in production.
WATCH_NOTIFY=false
BIAS_NOTIFY=false

# Worker weekly FREE-channel Engine Discipline digest (defaults to true in Wrangler)
ENGINE_DIGEST=true
